---
const { title, category, client, thumbnail, slug, link } = Astro.props;
const href = link ?? `/portfolio/${slug}`;
---

<a class="card" href={href}>
  {thumbnail && <img src={thumbnail} alt={`${title} thumbnail`} class="thumbnail" />}

  <div class="card-content">
    <p class="category">{category}</p>

    <h3>{title}</h3>

    <p>{client}</p>
  </div>
</a>

<style>
.card {
  border: 1px solid #dedbd3;
  border-radius: 12px;
  overflow: hidden;
  background: #f9f8f5;
  color: inherit;
  text-decoration: none;
  display: block;
}

.thumbnail {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  display: block;
  background: #dedbd3;
}

.card-content {
  padding: 24px;
}
</style>