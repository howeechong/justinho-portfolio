

---
import MainLayout from '../../layouts/MainLayout.astro';

const images = [
  '/images/photography/touch-rugby/TR_1.jpg',
  '/images/photography/touch-rugby/TR_2.jpg',
  '/images/photography/touch-rugby/TR_3.jpg',
  '/images/photography/touch-rugby/TR_4.jpg',
  '/images/photography/touch-rugby/TR_5.jpg',
  '/images/photography/touch-rugby/TR_6.jpg',
  '/images/photography/touch-rugby/TR_7.jpg',
  '/images/photography/touch-rugby/TR_8.jpg',
];
---

<MainLayout title="Touch Rugby | Justin Ho">
  <a href="/photography" class="back-link">← Back to Photography</a>

  <section class="project-hero">
    <p class="eyebrow">Photography</p>
    <h1>Touch Rugby</h1>
    <p class="intro">
      A sideline photo story documenting movement, teamwork and moments of intensity during a touch rugby match.
    </p>
  </section>

  <section class="photo-grid" aria-label="Touch rugby photo gallery">
    {images.map((image, index) => (
      <img
        src={image}
        alt={`Touch rugby photograph ${index + 1}`}
        loading={index === 0 ? 'eager' : 'lazy'}
      />
    ))}
  </section>

  <section class="project-details">
    <h2>Project Notes</h2>
    <p>
      This series was photographed from the sidelines, focusing on the rhythm of the game, the physicality of the players
      and the small in-between moments that happen around the action.
    </p>
    <p>
      I approached the match as a storytelling exercise: observing movement, anticipating reactions and looking for images
      that captured both competition and camaraderie.
    </p>
  </section>
</MainLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 48px;
    color: var(--muted);
    text-decoration: none;
  }

  .project-hero {
    max-width: 760px;
    margin-bottom: 56px;
  }

  .intro {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 64px;
  }

  .photo-grid img {
    width: 100%;
    height: 100%;
    max-height: 620px;
    object-fit: cover;
    border-radius: 16px;
  }

  .project-details {
    max-width: 720px;
  }

  @media (max-width: 720px) {
    .photo-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .photo-grid img {
      max-height: none;
    }
  }
</style>