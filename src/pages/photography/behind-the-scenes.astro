

---
import MainLayout from '../../layouts/MainLayout.astro';

const images = [
  '/images/photography/behind-the-scenes/BTS_1.jpg',
    '/images/photography/behind-the-scenes/BTS_2.jpg',
    '/images/photography/behind-the-scenes/BTS_3.jpg',
    '/images/photography/behind-the-scenes/BTS_4.jpg',
    '/images/photography/behind-the-scenes/BTS_5.jpg',
    '/images/photography/behind-the-scenes/BTS_6.jpg',
    '/images/photography/behind-the-scenes/BTS_7.jpg',
    '/images/photography/behind-the-scenes/BTS_8.jpg',
    '/images/photography/behind-the-scenes/BTS_9.jpg',
    '/images/photography/behind-the-scenes/BTS_10.jpg',
    
];
---

<MainLayout title="Behind the Scenes | Justin Ho">
  <a href="/photography" class="back-link">← Back to Photography</a>

  <section class="project-hero">
    <p class="eyebrow">Photography</p>
    <h1>Behind the Scenes</h1>
    <p class="intro">
      A photographic look behind the camera, documenting the people, preparation and collaboration that bring commercial productions to life.
    </p>
  </section>

  <section class="photo-grid" aria-label="Behind the Scenes photo gallery">
    {images.map((image, index) => (
      <img
        src={image}
        alt={`Behind the Scenes ${index + 1}`}
        loading={index === 0 ? 'eager' : 'lazy'}
      />
    ))}
  </section>

  <section class="project-details">
    <h2>Project Notes</h2>

    <p>
      Behind every finished film is a team of creatives, technicians and clients working together to solve problems,
      make decisions and bring ideas to life. This series focuses on the moments that audiences rarely see — the
      preparation before a take, the conversations between departments and the small details that keep a production
      moving forward.
    </p>

    <p>
      Photographed across a variety of commercial shoots, these images document the rhythm of life on set. Rather than
      focusing on the final advertisement, I was interested in capturing the process behind it: the collaboration,
      concentration and craftsmanship that exist behind the camera.
    </p>

    <p>
      Many of these moments are fleeting, disappearing as quickly as the next setup begins. Together, they form a visual
      record of the people and effort that make production possible.
    </p>
  </section>
</MainLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 48px;
    color: var(--muted);
    text-decoration: none;
  }

  .project-hero {
    max-width: 760px;
    margin-bottom: 56px;
  }

  .intro {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 64px;
  }

  .photo-grid img {
    width: 100%;
    height: 100%;
    max-height: 620px;
    object-fit: cover;
    border-radius: 16px;
  }

  .project-details {
    max-width: 720px;
  }

  @media (max-width: 720px) {
    .photo-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .photo-grid img {
      max-height: none;
    }
  }
</style>