---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact | Justin Ho">
  <section class="contact-page">
    <img
      src="/images/photography/justin-ho.jpg"
      alt="Justin Ho"
      class="profile-photo"
    />

    <h1>Let's Connect</h1>

    <p>
      I’m Justin Ho, a Singapore-based video editor with over a decade of experience crafting branded content, documentaries and digital campaigns. I enjoy finding the story hidden within footage and shaping it into work that feels clear, engaging and human.

If you’re looking for an editor, videographer or creative collaborator, I’d be happy to hear about your project.
    </p>

    <p>
      Email:
      <a href="mailto:hello@justinho.sg">hello@justinho.sg</a>
    </p>
  </section>
</MainLayout>

<style>
  .contact-page {
    max-width: 720px;
    margin: 0 auto;
  }

  .profile-photo {
    width: 240px;
    border-radius: 16px;
    margin-bottom: 32px;
  }
</style>