---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Justin Ho | Visual Storytelling">
  <section class="hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Video • Photography • Documentary</p>

        <h1>Stories matter.</h1>

        <p class="hero-text">
          I’m Justin Ho, a visual storyteller with a background in video editing, photography and documentary production.
          I help brands, organisations and individuals tell meaningful stories through compelling visuals.
        </p>

        <div class="hero-actions">
          <a href="/portfolio" class="button">View Portfolio</a>
          <a href="/contact" class="text-link">Contact Me</a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <img
          src="/images/photography/justin-ho.jpg"
          alt="Justin Ho"
          class="hero-image"
        />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    max-width: 1200px;
    padding: 80px 0 120px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 80px;
    align-items: center;
  }

  .hero-image {
    width: 100%;
    border-radius: 24px;
    display: block;
  }

  .hero-image-wrapper {
    justify-self: end;
    width: 100%;
    max-width: 420px;
  }

  .eyebrow {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    margin: 0 0 32px;
  }

  .hero-text {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--muted);
    max-width: 660px;
  }

  .hero-actions {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-top: 40px;
  }

  .button {
    border: 1px solid var(--text);
    padding: 12px 20px;
    border-radius: 999px;
  }

  .text-link {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      gap: 20px;
      flex-direction: column;
    }

    .site-nav {
      flex-wrap: wrap;
      gap: 16px;
    }

    .hero {
      padding-top: 48px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-image-wrapper {
      order: -1;
    }
  }
</style>