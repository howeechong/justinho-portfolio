---
import MainLayout from "../layouts/MainLayout.astro";
import { journalPosts } from "../data/journal";
---

<MainLayout title="Journal | Justin Ho">
  <section class="journal-page">
    <p class="eyebrow">Journal</p>
    <h1>Thoughts on stories, images and the moments between.</h1>

    <p class="journal-intro">
      Notes and reflections on photography, editing, storytelling and the way visual work helps us notice what matters.
    </p>

    <div class="journal-list">
      {journalPosts.map((post) => (
        <a href={post.href} class="journal-card">
          <p class="journal-meta">{post.category}</p>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
          <span>Read Article →</span>
        </a>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  .journal-page {
    max-width: 900px;
  }

  .journal-intro {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: 56px;
  }

  .journal-list {
    display: grid;
    gap: 24px;
  }

  .journal-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
  }

  .journal-card:hover {
    transform: translateY(-2px);
  }

  .journal-meta {
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .journal-card h2 {
    margin: 0 0 12px;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
  }

  .journal-card p {
    color: var(--muted);
    max-width: 640px;
  }

  .journal-card span {
    display: inline-block;
    margin-top: 16px;
  }
</style>